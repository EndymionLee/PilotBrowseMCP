{
  "name": "full-system-test",
  "description": "覆盖全部 Extension 端可用工具的静态测试",
  "steps": [
    { "method": "browser_list_tabs", "params": {} },
    { "method": "browser_current_page", "params": {} },
    { "method": "browser_open", "params": { "url": "https://example.com", "active": true } },
    { "method": "browser_wait", "params": { "ms": 2000 } },
    { "method": "browser_get_markdown", "params": {} },
    { "method": "browser_get_text", "params": {} },
    { "method": "browser_get_html", "params": {} },
    { "method": "browser_query", "params": { "selector": "h1, h2, p, a, img" } },
    { "method": "browser_find", "params": { "text": "Example", "tag": "a" } },
    { "method": "browser_evaluate", "params": { "code": "document.title" } },
    { "method": "browser_extract_article", "params": {} },
    { "method": "browser_extract_links", "params": {} },
    { "method": "browser_extract_images", "params": {} },
    { "method": "browser_extract_table", "params": {} },
    { "method": "browser_scroll", "params": { "direction": "down", "amount": 300 } },
    { "method": "browser_wait_for_element", "params": { "selector": "body" } },
    { "method": "browser_click", "params": { "selector": "a[href]" } },
    { "method": "browser_type", "params": { "selector": "input[type='text'], input[name='q'], [contenteditable]", "text": "hello" } },
    { "method": "browser_screenshot", "params": {} },
    { "method": "browser_permissions_list", "params": {} },
    { "method": "browser_cookies", "params": {} },
    { "method": "browser_local_storage", "params": {} },
    { "method": "browser_start_network_monitor", "params": {} },
    { "method": "browser_open", "params": { "url": "https://httpbin.org/get", "active": false } },
    { "method": "browser_wait", "params": { "ms": 2000 } },
    { "method": "browser_network_search", "params": { "keyword": "httpbin", "mimeType": "application/json" } },
    { "method": "browser_network_clear_cache", "params": {} },
    { "method": "browser_stop_network_monitor", "params": {} },
    { "method": "browser_activate", "params": {} },
    { "method": "browser_close", "params": {} }
  ]
}
